# API Go membaca variabel environment langsung; file ini hanya contoh.
# Untuk APP_ENV=local, DATABASE_URL boleh dikosongkan dan otomatis memakai Postgres dari compose.dev.yml.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8300
DATABASE_URL=postgres://jdsign:jdsign-dev@127.0.0.1:54329/jdsign?sslmode=disable

# Hanya untuk tes integrasi (go test ./...). Tes yang butuh database dilewati jika kosong.
TEST_DATABASE_URL=postgres://jdsign:jdsign-dev@127.0.0.1:54329/jdsign?sslmode=disable
