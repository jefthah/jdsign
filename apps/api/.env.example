# API Go membaca variabel environment langsung; file ini hanya contoh.
# Untuk APP_ENV=local, DATABASE_URL boleh dikosongkan dan otomatis memakai Postgres dari compose.dev.yml.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8300
DATABASE_URL=postgres://jdsign:jdsign-dev@127.0.0.1:54329/jdsign?sslmode=disable

# Alamat publik aplikasi (frontend dan API satu domain). Di luar local wajib https.
# Dipakai untuk cek Origin (CSRF), cookie Secure, dan URL callback Google.
APP_URL=http://localhost:3000
# Rahasia HMAC kode masuk, minimal 32 karakter. Di local boleh kosong (memakai rahasia pengembangan tetap).
# Buat dengan: openssl rand -hex 32
LOGIN_CODE_SECRET=
# Kosong = kode masuk hanya ditulis ke log API (local/staging). Wajib di production.
RESEND_API_KEY=
MAIL_FROM=JD Sign <hello@jd-sign.com>
# Login Google aktif hanya jika keduanya diisi. Redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hanya untuk tes integrasi (go test ./...). Tes yang butuh database dilewati jika kosong.
TEST_DATABASE_URL=postgres://jdsign:jdsign-dev@127.0.0.1:54329/jdsign?sslmode=disable
